on early-init
    setprop ro.hardware.keystore_deprecated=true
    mkdir /vendor 0755 root root
    mkdir /vendor/persist 0771 system system
    mkdir /mnt/vendor
    mkdir /mnt/vendor/persist 0771 system system
    mkdir /metadata 0771 system system
    mkdir /sys/kernel/debug 0771 system system
    mount debugfs debugfs /sys/kernel/debug

    # Wait until device-mapper nodes are ready (dynamic partitions)
    wait /dev/block/dm-3 10
    mount ext4 /dev/block/dm-3 /vendor
    # If anything expects vendor under /mnt/vendor, mirror it.
    mount none /vendor /mnt/vendor bind
    # ────────────────────────────────────────────────────────────────
    # Mount /metadata from mmcblk0p10 (ext4)
    # ────────────────────────────────────────────────────────────────
    mount ext4 /dev/block/mmcblk0p10 /metadata
    
on init
    start health-hal-2-0
    setprop sys.usb.configfs 1
    setprop sys.usb.ffs.aio_compat 1

on fs && property:ro.debuggable=0
    # distinguish USB should connect or not, i.e. CDP vs SDP
    write /sys/class/udc/musb-hdrc/device/cmode 2
    # set charging free due to it wait for USB activation
    start adbd

on post-fs
    # Support A/B feature for emmc boot region
    symlink /dev/block/sda /dev/block/mmcblk0boot0
    symlink /dev/block/sdb /dev/block/mmcblk0boot1
    symlink /dev/block/mmcblk0boot0 /dev/block/platform/bootdevice/by-name/preloader_a
    symlink /dev/block/mmcblk0boot1 /dev/block/platform/bootdevice/by-name/preloader_b
    symlink /dev/block/mmcblk0boot0 /dev/block/by-name/preloader_a
    symlink /dev/block/mmcblk0boot1 /dev/block/by-name/preloader_b
